FROM golang:1.27.0-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/orchestrator-worker ./cmd/orchestrator-worker

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build --chown=nonroot:nonroot /out/orchestrator-worker /orchestrator-worker
USER nonroot:nonroot
ENTRYPOINT ["/orchestrator-worker"]
