FROM golang:1.27.0-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/redfish-simulator ./cmd/redfish-simulator

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build --chown=nonroot:nonroot /out/redfish-simulator /redfish-simulator
USER nonroot:nonroot
EXPOSE 8081
ENTRYPOINT ["/redfish-simulator"]
