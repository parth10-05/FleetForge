# Safe development defaults. Do not add credentials or real endpoints here.
FLEETFORGE_ENV=development
FLEETFORGE_LOG_LEVEL=info
FLEETFORGE_SHUTDOWN_TIMEOUT=10s
FLEETFORGE_READINESS_TIMEOUT=500ms

# API role
FLEETFORGE_API_ADDR=127.0.0.1:8080

# Simulator role. These are local, non-secret paths for a new test run.
FLEETFORGE_SIMULATOR_ADDR=127.0.0.1:8081
FLEETFORGE_SIMULATOR_STATE_PATH=.fleetforge/simulator-state.json
FLEETFORGE_SIMULATOR_JOURNAL_PATH=.fleetforge/simulator-journal.json
FLEETFORGE_SIMULATOR_SCENARIO_PATH=test/fixtures/simulator/v1/healthy.json

# Optional secret reference only. Never put a secret value in this file.
# FLEETFORGE_SECRET_REFERENCE=secret://replace-with-provider-reference

# PostgreSQL is opt-in. FleetForge prefers the explicit role-specific names
# below. A Neon-linked developer environment may instead provide the standard
# DATABASE_URL (pooled application connection) and DATABASE_URL_UNPOOLED
# (direct migration connection) variables. Never add a real URL here.
# FLEETFORGE_POSTGRES_APP_DSN=postgresql://app:replace-me@localhost:5432/fleetforge?sslmode=disable
# FLEETFORGE_POSTGRES_MIGRATION_DSN=postgresql://migrate:replace-me@localhost:5432/fleetforge?sslmode=disable
